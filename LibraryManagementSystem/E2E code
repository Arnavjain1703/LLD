import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.atomic.AtomicInteger;

class Main {

    public static void main(String[] args) {

        List<String> authors = List.of("J.K. Rowling");

        Book book = new Book.Builder()
                .setBookName("Harry Potter")
                .setBookType(BookType.HORROR)
                .setBookAuthor(authors)
                .build();
    }
}


// ============================================================
// Enums
// ============================================================

enum BookType {
    HORROR,
    FUNNY,
    ROMANTIC
}

enum BookItemStatus {
    AVAILABLE,
    DAMAGED,
    LOST,
    BORROWED
}


// ============================================================
// Exceptions
// ============================================================

class BookNotAvailableException extends RuntimeException {

    public BookNotAvailableException(String message) {
        super(message);
    }
}


// ============================================================
// Book
// ============================================================

class Book {

    private static final AtomicInteger counter = new AtomicInteger(0);

    private final int bookId;
    private final String bookName;
    private final BookType bookType;
    private final List<String> bookAuthor;

    private Book(Builder builder) {

        this.bookId = counter.incrementAndGet();
        this.bookName = builder.bookName;
        this.bookType = builder.bookType;

        // Defensive copy + immutable list
        this.bookAuthor = List.copyOf(builder.bookAuthor);
    }

    // --------------------------------------------------------
    // Builder
    // --------------------------------------------------------

    static class Builder {

        private String bookName;
        private BookType bookType;
        private List<String> bookAuthor = new ArrayList<>();

        public Builder setBookName(String bookName) {
            this.bookName = bookName;
            return this;
        }

        public Builder setBookType(BookType bookType) {
            this.bookType = bookType;
            return this;
        }

        public Builder setBookAuthor(List<String> bookAuthor) {
            this.bookAuthor = new ArrayList<>(bookAuthor);
            return this;
        }

        public Book build() {
            return new Book(this);
        }
    }
}


// ============================================================
// BookItem
// ============================================================

class BookItem {

    private final String barcode;
    private final Book book;

    private BookItemStatus status;

    public BookItem(String barcode, Book book) {
        this.barcode = barcode;
        this.book = book;
        this.status = BookItemStatus.AVAILABLE;
    }

    // --------------------------------------------------------
    // Borrow / Checkout
    // --------------------------------------------------------

    /**
     * Called by BorrowService.
     * Synchronized to prevent two threads from borrowing
     * the same BookItem simultaneously.
     */
    public synchronized void checkout() {

        if (status != BookItemStatus.AVAILABLE) {
            throw new BookNotAvailableException(
                    "BookItem " + barcode
                            + " is not available. Current status: " + status
            );
        }

        this.status = BookItemStatus.BORROWED;
    }

    // --------------------------------------------------------
    // Return
    // --------------------------------------------------------

    /**
     * Called by ReturnService.
     */
    public synchronized void markReturned() {

        if (status != BookItemStatus.BORROWED) {
            throw new IllegalStateException(
                    "Cannot return BookItem " + barcode
                            + " — status is: " + status
            );
        }

        this.status = BookItemStatus.AVAILABLE;
    }

    // --------------------------------------------------------
    // Lost / Damaged
    // --------------------------------------------------------

    public void markLost() {
        this.status = BookItemStatus.LOST;
    }

    public void markDamaged() {
        this.status = BookItemStatus.DAMAGED;
    }

    // --------------------------------------------------------
    // Getters
    // --------------------------------------------------------

    public String getBarcode() {
        return barcode;
    }

    public Book getBook() {
        return book;
    }

    public BookItemStatus getStatus() {
        return status;
    }

    public boolean isAvailable() {
        return status == BookItemStatus.AVAILABLE;
    }
}
